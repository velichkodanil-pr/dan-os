# DAN.OS — environment variables (placeholders only; real values live in Railway variables / local .env)
TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=<LONG_RANDOM_STRING>
OWNER_TELEGRAM_ID=0
DATABASE_URL=
# RAILWAY_PUBLIC_DOMAIN is injected by Railway automatically when a domain exists
# TravelON read-only report token (R4 business pulse) — full-access secret
TRAVELON_TOKEN=

# R6.1A — knowledge safety
# Automatic wiki compilation sends stored documents to the model. It stays OFF
# until /kb_security_scan has confirmed the base carries no credentials; the
# flag alone is not enough, the scan gate must also be complete.
AUTO_WIKI_COMPILE_ENABLED=false
